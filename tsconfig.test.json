{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": "./work/test-build",
    "plugins": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/*.test.ts", "tests/*.test.tsx"],
  "exclude": ["node_modules"]
}
